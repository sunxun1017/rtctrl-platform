# Shared ARM64/RK3588 build inputs. Board profiles may override these values.
RTCTRL_PROFILE_SCHEMA=1
RTCTRL_SOC=rk3588
RTCTRL_ARCH=arm64
RTCTRL_TARGET_TRIPLE_DEFAULT=aarch64-linux-gnu
RTCTRL_CMAKE_PRESET=aarch64
RTCTRL_TARGET_TRIPLE=${RTCTRL_TARGET_TRIPLE:-aarch64-linux-gnu}
RTCTRL_CROSS_COMPILE=${RTCTRL_CROSS_COMPILE:-${RTCTRL_TARGET_TRIPLE}-}
RTCTRL_KERNEL_DEFCONFIG=rockchip_linux_defconfig
RTCTRL_KERNEL_FRAGMENTS="arch/arm64/configs/rk3588_linux.config arch/arm64/configs/rockchip_rt.config"
