root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,h,hpp}]
indent_style = space
indent_size = 4
tab_width = 4

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{md,yaml,yml}]
trim_trailing_whitespace = false
