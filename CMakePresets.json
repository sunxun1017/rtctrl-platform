{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "humanoid23",
      "displayName": "Release - Yidong 23 joint profile",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/humanoid23",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTCTRL_JOINT_COUNT": "23"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RTCTRL_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "igh",
      "displayName": "Release - IgH EtherCAT adapter",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/igh",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTCTRL_ENABLE_IGH_ETHERCAT": "ON",
        "RTCTRL_IGH_ROOT": "/opt/etherlab"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RTCTRL_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "riscv64",
      "displayName": "RISC-V 64 cross build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/riscv64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-cross.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTCTRL_TARGET_TRIPLE": "riscv64-linux-gnu",
        "RTCTRL_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "aarch64",
      "displayName": "AArch64 Linux cross build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/aarch64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-cross.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTCTRL_TARGET_TRIPLE": "aarch64-linux-gnu",
        "RTCTRL_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "atk-dlrv1126b",
      "displayName": "ALIENTEK ATK-DLRV1126B userspace cross build",
      "inherits": "aarch64",
      "binaryDir": "${sourceDir}/build/atk-dlrv1126b",
      "cacheVariables": {
        "RTCTRL_TARGET_TRIPLE": "aarch64-buildroot-linux-gnu"
      }
    },
    {
      "name": "control-sim",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/control-sim",
      "cacheVariables": {
        "RTCTRL_PRODUCT": "control-sim",
        "RTCTRL_ENABLE_POSIX_SHM": "OFF",
        "RTCTRL_ENABLE_KERNEL_MAILBOX": "OFF",
        "RTCTRL_ENABLE_SERIAL": "OFF",
        "RTCTRL_ENABLE_SOCKETCAN": "OFF"
      }
    },
    {
      "name": "vision-node",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/vision-node",
      "cacheVariables": {
        "RTCTRL_PRODUCT": "vision-node"
      }
    },
    {
      "name": "robot-vision",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/robot-vision",
      "cacheVariables": {
        "RTCTRL_PRODUCT": "robot-vision"
      }
    },
    {
      "name": "vision-synthetic",
      "inherits": "vision-node",
      "binaryDir": "${sourceDir}/build/vision-synthetic",
      "cacheVariables": {
        "RTCTRL_ENABLE_V4L2": "OFF"
      }
    },
    {
      "name": "face-host",
      "displayName": "Host face recognition algorithms and CLI",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/face-host",
      "cacheVariables": {
        "RTCTRL_ENABLE_FACE_RECOGNITION": "ON",
        "RTCTRL_ENABLE_RKNN": "ON",
        "RTCTRL_FACE_BUILD_CLI": "ON",
        "RTCTRL_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "humanoid23",
      "configurePreset": "humanoid23"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
