{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 16, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "humanoid23",
      "displayName": "Release - Yidong 23 joint profile",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/humanoid23",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTCTRL_JOINT_COUNT": "23"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RTCTRL_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "igh",
      "displayName": "Release - IgH EtherCAT adapter",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/igh",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTCTRL_ENABLE_IGH_ETHERCAT": "ON",
        "RTCTRL_IGH_ROOT": "/opt/etherlab"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RTCTRL_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "riscv64",
      "displayName": "RISC-V 64 cross build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/riscv64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-cross.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTCTRL_TARGET_TRIPLE": "riscv64-linux-gnu",
        "RTCTRL_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "aarch64",
      "displayName": "AArch64 Linux cross build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/aarch64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-cross.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTCTRL_TARGET_TRIPLE": "aarch64-linux-gnu",
        "RTCTRL_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "humanoid23", "configurePreset": "humanoid23" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "igh", "configurePreset": "igh" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "riscv64", "configurePreset": "riscv64" },
    { "name": "aarch64", "configurePreset": "aarch64" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "humanoid23", "configurePreset": "humanoid23", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "igh", "configurePreset": "igh", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
  ]
}
