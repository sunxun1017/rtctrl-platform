{
  "mode": "live",
  "voice_backend": "local",
  "port": 8092,
  "device_settings_enabled": true,
  "wifi_enabled": false,
  "listen_mode": "manual",
  "capture_device": "rtctrl_es8389_capture",
  "playback_device": "rtctrl_es8389",
  "max_listen_s": 15,
  "response_timeout_s": 180,
  "qianfan_model": "ernie-4.5-turbo-32k",
  "qianfan_token_env": "BAIDU_QIANFAN_API_KEY",
  "qianfan_proxy_url": "",
  "local_speech_root": "/userdata/rtctrl-speech",
  "local_speech_socket": "/run/rtctrl-companion/speech.sock",
  "local_tts_kind": "vits",
  "local_tts_speaker": 0,
  "local_asr_command": [
    "/usr/bin/python3",
    "/userdata/rtctrl-companion/deploy/companion/speech-client.py",
    "--socket",
    "/run/rtctrl-companion/speech.sock",
    "--operation",
    "asr",
    "--input",
    "{input}",
    "--output",
    "{output}"
  ],
  "local_tts_command": [
    "/usr/bin/python3",
    "/userdata/rtctrl-companion/deploy/companion/speech-client.py",
    "--socket",
    "/run/rtctrl-companion/speech.sock",
    "--operation",
    "tts",
    "--text",
    "{text}",
    "--output",
    "{output}"
  ],
  "face_url": "http://127.0.0.1:8080/status.json"
}
